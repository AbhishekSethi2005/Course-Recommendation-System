# CourseIQ - Production Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with secrets to Git.

# ── OpenAI API Configuration ──────────────────────────────────────────────────
# Required for CourseIQ Assistant Chatbot.
# Format: sk-proj-...
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (gpt-4o-mini is recommended for speed and cost efficiency)
OPENAI_MODEL=gpt-4o-mini

# ── Flask Backend Configuration ───────────────────────────────────────────────
PORT=5000
DATA_DIR=/app/data

# ── Gunicorn Concurrency Settings ─────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

